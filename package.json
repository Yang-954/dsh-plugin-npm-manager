{
  "name": "dsh-plugin-npm-manager",
  "version": "0.7.1",
  "type": "module",
  "description": "DSH plugin: list local/global npm packages in Settings → Plugins with version, description, outdated status, and upgrade actions.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.2"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "files": [
    "lib",
    "client",
    "src",
    "scripts",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "PLUGIN_DEV_GUIDE.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:client": "node scripts/build-client.mjs",
    "test": "node scripts/build-client.mjs && node tests/tool-schema-verify.mjs && node tests/routes-verify.mjs && node tests/client-verify.mjs && node scripts/dev-conformance-check.mjs"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^22.0.0"
  }
}
