{
  "name": "dsh-plugin-npm-manager",
  "version": "0.8.0",
  "type": "module",
  "description": "DSH plugin: list local/global npm packages in Settings → Plugins with version, description, outdated status, and upgrade actions.",
  "license": "MIT",
  "author": "Yang-954",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yang-954/dsh-plugin-npm-manager.git"
  },
  "homepage": "https://github.com/Yang-954/dsh-plugin-npm-manager#readme",
  "bugs": {
    "url": "https://github.com/Yang-954/dsh-plugin-npm-manager/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "npm",
    "package-manager",
    "deepseek-harness"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "files": [
    "lib",
    "client",
    "src",
    "!src/.patched",
    "!src/**/*.patched.ts",
    "!src/**/*.patched.d.ts",
    "!src/**/*.patched.js",
    "scripts",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "DEPLOY.md",
    "PLUGIN_DEV_GUIDE.md",
    "PROJECT_STATUS.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "build:client": "node scripts/build-client.mjs",
    "test": "node scripts/build-client.mjs && node tests/tool-schema-verify.mjs && node tests/routes-verify.mjs && node tests/client-verify.mjs && node scripts/dev-conformance-check.mjs && node tests/host-contract-021.mjs"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^22.0.0"
  }
}
